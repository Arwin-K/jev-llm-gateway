FROM python:3.12.7-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    LAYA_HOST=0.0.0.0 LAYA_PORT=8000 LAYA_DEVICE=cpu \
    LAYA_MODELS=typed-decisions LAYA_PRELOAD=1 LAYA_REVISION=reviewed \
    HF_HOME=/model-cache
WORKDIR /app
COPY requirements/laya-container.txt ./requirements/laya-container.txt
RUN python -m pip install --no-cache-dir -r requirements/laya-container.txt && \
    useradd --system --uid 10002 --create-home laya && \
    mkdir -p /model-cache && chown -R laya:laya /app /model-cache
USER laya
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=180s \
  CMD python -c 'from urllib.request import urlopen; urlopen("http://127.0.0.1:8000/health", timeout=3).close()'
CMD ["/usr/local/bin/laya-serve"]
