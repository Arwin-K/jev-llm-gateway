# Copy to an untracked .env and export with your shell. No secret is stored here.
JEV_SMALL_URL=http://127.0.0.1:11434/v1
JEV_SMALL_MODEL=qwen2.5:1.5b
JEV_MEDIUM_URL=http://127.0.0.1:11434/v1
JEV_MEDIUM_MODEL=qwen2.5:7b
JEV_TIMEOUT_SECONDS=60
JEV_MAX_OUTPUT_TOKENS=256
# Paid frontier remains disabled until a model, key, current rates, and positive caps are set.
# JEV_FRONTIER_MODEL=
# JEV_FRONTIER_URL=https://api.openai.com/v1
# JEV_FRONTIER_API_KEY=
# JEV_FRONTIER_MAX_REQUESTS=0
# JEV_FRONTIER_MAX_TOKENS=0
# JEV_FRONTIER_MAX_USD=0
# JEV_FRONTIER_INPUT_USD_PER_MILLION=0
# JEV_FRONTIER_OUTPUT_USD_PER_MILLION=0

# Local Laya decision service. Start it separately on loopback with a pinned release.
# Positive process-local caps bound requests; no API key or per-call fee is used.
JEV_DECISION_PROVIDER=laya
JEV_DECISION_URL=http://127.0.0.1:8000
JEV_DECISION_MODEL=typed-decisions
JEV_DECISION_MAX_REQUESTS=100
JEV_DECISION_MAX_TOKENS=200000

# model=auto uses Laya and returns 503 if the local service is unavailable.
# Set JEV_ROUTER_POLICY=always-small for a router-free local check.
# Context ceilings are operator limits, not measured tokenizer limits.
JEV_ROUTER_POLICY=laya-choice
JEV_SMALL_CONTEXT_TOKENS=4096
JEV_MEDIUM_CONTEXT_TOKENS=4096
JEV_FRONTIER_CONTEXT_TOKENS=4096
# JEV_ROUTER_SEED=17
# JEV_ROUTER_ARTIFACT=runs/day3-distilbert
# JEV_ROUTER_TRAINING_FINGERPRINT=<from saved generation results>
# JEV_ROUTER_THRESHOLDS=runs/day3-validation-selection.json
# Optional hosted Jev comparison. Keep disabled unless explicitly authorized.
# TYPESAFE_API_KEY=
# JEV_DECISION_PROVIDER=jev
# JEV_DECISION_URL=https://api.typesafe.ai
# JEV_DECISION_MODEL=jev-1
# JEV_DECISION_MAX_REQUESTS=0
# JEV_DECISION_MAX_TOKENS=0
# JEV_DECISION_MAX_USD=0
# JEV_DECISION_INPUT_USD_PER_MILLION=0
# JEV_DECISION_OUTPUT_USD_PER_MILLION=0
# Strands must be explicitly started on loopback with a pinned checkpoint.
# JEV_STRANDS_URL=http://127.0.0.1:8099
# JEV_STRANDS_MODEL=hobson-latest
# JEV_STRANDS_CHECKPOINT=<pinned-local-path>
# JEV_STRANDS_DEVICE=mps
# JEV_DECISION_RATE_SOURCE_URL=https://<official-current-rate-page>
# JEV_DECISION_RATE_EFFECTIVE_DATE=YYYY-MM-DD

# Day 5 local service controls. Keep JEV_BIND_HOST at its default loopback
# outside containers; the image sets 0.0.0.0 only inside its private network.
JEV_MAX_ACTIVE_REQUESTS=8
JEV_MAX_QUEUED_REQUESTS=16
JEV_EXECUTION_MAX_REQUESTS=4
JEV_EXECUTION_MAX_TOKENS=25000
JEV_EXECUTION_MAX_USD=0
JEV_BREAKER_FAILURES=3
JEV_BREAKER_COOLDOWN_SECONDS=30
JEV_AVAILABILITY_FAILOVER_ENABLED=false
# Set true only when a compatible trained DistilBERT artifact is mounted.
JEV_REQUIRE_TRAINED_FALLBACK=false
