# Copy to an untracked .env and export with your shell. No secret is stored here.
JEV_SMALL_URL=http://127.0.0.1:11434/v1
JEV_SMALL_MODEL=qwen2.5:1.5b
JEV_MEDIUM_URL=http://127.0.0.1:11434/v1
JEV_MEDIUM_MODEL=qwen2.5:7b
JEV_TIMEOUT_SECONDS=60
JEV_MAX_OUTPUT_TOKENS=256
# Paid frontier remains disabled until a model, key, current rates, and positive caps are set.
# JEV_FRONTIER_MODEL=
# JEV_FRONTIER_URL=https://api.openai.com/v1
# JEV_FRONTIER_API_KEY=
# JEV_FRONTIER_MAX_REQUESTS=0
# JEV_FRONTIER_MAX_TOKENS=0
# JEV_FRONTIER_MAX_USD=0
# JEV_FRONTIER_INPUT_USD_PER_MILLION=0
# JEV_FRONTIER_OUTPUT_USD_PER_MILLION=0
