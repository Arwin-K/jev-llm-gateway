# Copy to an untracked .env and export with your shell. No secret is stored here.
JEV_SMALL_URL=http://127.0.0.1:11434/v1
JEV_SMALL_MODEL=qwen2.5:1.5b
JEV_MEDIUM_URL=http://127.0.0.1:11434/v1
JEV_MEDIUM_MODEL=qwen2.5:7b
JEV_TIMEOUT_SECONDS=60
JEV_MAX_OUTPUT_TOKENS=256
# Paid frontier remains disabled until a model, key, current rates, and positive caps are set.
# JEV_FRONTIER_MODEL=
# JEV_FRONTIER_URL=https://api.openai.com/v1
# JEV_FRONTIER_API_KEY=
# JEV_FRONTIER_MAX_REQUESTS=0
# JEV_FRONTIER_MAX_TOKENS=0
# JEV_FRONTIER_MAX_USD=0
# JEV_FRONTIER_INPUT_USD_PER_MILLION=0
# JEV_FRONTIER_OUTPUT_USD_PER_MILLION=0

# Day 3 automatic routing. Jev choice is the default; without the conditions below,
# model=auto returns 503. Configure JEV_ROUTER_POLICY=always-small for a local-only
# comparison after Ollama is running. Default context ceilings are conservative
# operator settings, not verified tokenizer limits.
JEV_ROUTER_POLICY=jev-choice
JEV_SMALL_CONTEXT_TOKENS=4096
JEV_MEDIUM_CONTEXT_TOKENS=4096
JEV_FRONTIER_CONTEXT_TOKENS=4096
# JEV_ROUTER_SEED=17
# JEV_ROUTER_ARTIFACT=runs/day3-distilbert
# JEV_ROUTER_TRAINING_FINGERPRINT=<from saved generation results>
# JEV_ROUTER_THRESHOLDS=runs/day3-validation-selection.json
# TYPESAFE_API_KEY=
# JEV_DECISION_MODEL=
# JEV_DECISION_MAX_REQUESTS=0
# JEV_DECISION_MAX_TOKENS=0
# JEV_DECISION_MAX_USD=0
# JEV_DECISION_INPUT_USD_PER_MILLION=0
# JEV_DECISION_OUTPUT_USD_PER_MILLION=0
# Strands must be explicitly started on loopback with a pinned checkpoint.
# JEV_STRANDS_URL=http://127.0.0.1:8099
# JEV_STRANDS_MODEL=hobson-latest
# JEV_STRANDS_CHECKPOINT=<pinned-local-path>
# JEV_STRANDS_DEVICE=mps
