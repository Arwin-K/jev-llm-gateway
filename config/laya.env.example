# Native Laya inference runs inside the laya-gateway process.
LAYA_MODEL=typed-decisions
LAYA_DEVICE=mps
LAYA_REVISION=reviewed
LAYA_MAX_REQUESTS=100
LAYA_MAX_INPUT_UNITS=200000

# Local Ollama text generation backends.
LAYA_GATEWAY_SMALL_URL=http://127.0.0.1:11434/v1
LAYA_GATEWAY_SMALL_MODEL=qwen2.5:1.5b
LAYA_GATEWAY_SMALL_CONTEXT_TOKENS=4096
LAYA_GATEWAY_MEDIUM_URL=http://127.0.0.1:11434/v1
LAYA_GATEWAY_MEDIUM_MODEL=qwen2.5:7b
LAYA_GATEWAY_MEDIUM_CONTEXT_TOKENS=4096
LAYA_GATEWAY_MAX_OUTPUT_TOKENS=256
LAYA_GATEWAY_TIMEOUT_SECONDS=60
LAYA_GATEWAY_ROUTER_POLICY=laya-choice

# Keep the remote frontier tier disabled. No provider key or API is configured.
LAYA_GATEWAY_FRONTIER_MODEL=UNCONFIGURED
LAYA_GATEWAY_FRONTIER_MAX_REQUESTS=0
LAYA_GATEWAY_FRONTIER_MAX_TOKENS=0
LAYA_GATEWAY_FRONTIER_MAX_USD=0
